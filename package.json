{
  "name": "tengu",
  "version": "0.1.4",
  "private": true,
  "description": "Tengu",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8000",
    "balance": "node tools/rolecheck.mjs",
    "speed": "node tools/perf-check.mjs",
    "desktop": "electron .",
    "icon": "electron electron/make-icon.cjs",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "version": "node tools/sync-version.mjs && git add src/version.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "ikage24",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ikage24.tengu",
    "productName": "Tengu",
    "artifactName": "Tengu-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "electron/main.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tengu"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ikage24-wq",
        "repo": "Tengu",
        "releaseType": "release"
      }
    ]
  }
}
