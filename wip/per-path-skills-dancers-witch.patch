+
+// Every skill a second job can cast plays its own job's move: the first job's skills it inherits
+// are played the path's own way (`paths` in data/skills.js, "Per-path skill versions" in
+// world/combat.js), never with the first job's (or another path's) motion.
+test("no second job plays another job's move when casting any skill it can cast", async () => {
+  const { SKILLS, skillAt } = await import('../src/data/skills.js');
+  const { JOBS, jobChain } = await import('../src/data/jobs.js');
+  // Whose each move is: a skill's own combo belongs to its job, each path's version to that path.
+  const owners = new Map();
+  const own = (move, job) => owners.set(move, (owners.get(move) ?? new Set()).add(job));
+  const versions = (id) => {
+    const at = skillAt(id, SKILLS[id].maxLevel);
+    return { combo: at.combo ?? [], paths: at.paths ?? {} };
+  };
+  for (const [id, s] of Object.entries(SKILLS)) {
+    const { combo, paths } = versions(id);
+    for (const st of combo) own(st.move, s.job);
+    for (const [job, steps] of Object.entries(paths)) for (const st of steps) own(st.move, job);
+  }
+  // (The warrior and archer families get theirs in a separate pass: drop each from here once it lands.)
+  const pending = new Set(['paladin', 'berserker', 'beastmaster', 'stormcaller']);
+  const paths = Object.values(JOBS).filter((j) => j.tier === 2 && !j.hidden && !pending.has(j.id));
+  assert.ok(paths.length >= 4);
+  for (const { id: job } of paths) {
+    // (The beginner's own skills, Pebble and Quick Step, are everyone's.)
+    const chain = jobChain(job).filter((j) => j !== 'novice');
+    for (const [id, s] of Object.entries(SKILLS)) {
+      if (!chain.includes(s.job)) continue;
+      const { combo, paths: mine } = versions(id);
+      for (const st of mine[job] ?? combo) {
+        assert.ok(MOVES[st.move], `${job} ${id}: ${st.move} is drawn`);
+        const others = [...(owners.get(st.move) ?? [])].filter((o) => o !== job);
+        assert.deepEqual(others, [], `${JOBS[job].name} casting ${s.name} plays ${st.move}, a move of ${others.join(', ')}`);
+      }
+    }
+  }
+});
